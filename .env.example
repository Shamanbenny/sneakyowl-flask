# Firebase project that is also used by SneakyOwl.
FIREBASE_PROJECT_ID=

# JSON for a Firebase Admin service account, kept only in backend/Vercel secrets.
# Use one line of JSON when configuring Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,https://sneakyowl.net
